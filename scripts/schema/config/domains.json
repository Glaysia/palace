{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuration File Schema -- \"Domains\"",
  "type": "object",
  "additionalProperties": false,
  "required": ["Materials"],
  "properties":
  {
    "Materials":
    {
      "type": "array",
      "additionalItems": false,
      "items":
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["Attributes"],
        "properties":
        {
          "Attributes": { "$ref": "#/$defs/Attributes" },
          "Permeability":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "PermeabilityImag":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "MagneticLossTan":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "Permittivity":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "LossTan":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "Conductivity":
          {
            "oneOf" :
            [
              {"type": "number" },
              {
                "type": "array",
                "items" : { "type" :"number" },
                "minItems" : 3,
                "maxItems" : 3
              }
            ]
          },
          "PermeabilityFreq": { "$ref": "#/$defs/ScalarMaterialTable" },
          "PermittivityFreq": { "$ref": "#/$defs/ScalarMaterialTable" },
          "LondonDepth": { "type": "number" },
          "MaterialAxes":
          {
            "type" : "array",
            "items" :
            {
              "type" : "array",
              "items" : { "type": "number" },
              "minItems" : 3,
              "maxItems" : 3
            },
            "minItems" : 3,
            "maxItems" : 3
          }
        }
      }
    },
    "CurrentDipole":
    {
      "type": "array",
      "additionalItems": false,
      "items":
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["Index", "Moment", "Center", "Direction"],
        "properties":
        {
          "Index": { "type": "integer", "exclusiveMinimum": 0 },
          "Moment": { "type": "number" },
          "Center":
          {
            "type": "array",
            "additionalItems": false,
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "Direction":
          {
            "anyOf":
            [
              {
                "type": "string",
                "enum": ["X", "Y", "Z", "+X", "+Y", "+Z", "-X", "-Y", "-Z",
                         "x", "y", "z", "+x", "+y", "+z", "-x", "-y", "-z"]
              },
              {
                "type": "array",
                "additionalItems": false,
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        }
      }
    },
    "VolumeCurrent":
    {
      "type": "array",
      "additionalItems": false,
      "items":
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["Index", "Excitation", "Attributes", "CurrentDensity", "Direction"],
        "properties":
        {
          "Index": { "type": "integer", "exclusiveMinimum": 0 },
          "Excitation": { "type": "integer", "exclusiveMinimum": 0 },
          "Attributes": { "$ref": "#/$defs/Attributes" },
          "CurrentDensity": { "type": "number" },
          "Direction":
          {
            "anyOf":
            [
              {
                "type": "string",
                "enum": ["X", "Y", "Z", "+X", "+Y", "+Z", "-X", "-Y", "-Z",
                         "x", "y", "z", "+x", "+y", "+z", "-x", "-y", "-z"]
              },
              {
                "type": "array",
                "additionalItems": false,
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        }
      }
    },
    "Postprocessing":
    {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties":
      {
        "Energy":
        {
          "type": "array",
          "additionalItems": false,
          "items":
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["Index", "Attributes"],
            "properties":
            {
              "Index": { "type": "integer", "exclusiveMinimum": 0 },
              "Attributes": { "$ref": "#/$defs/Attributes" }
            }
          }
        },
        "Probe":
        {
          "type": "array",
          "additionalItems": false,
          "items":
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["Index", "Center"],
            "properties":
            {
              "Index": { "type": "integer", "exclusiveMinimum": 0 },
              "Center":
              {
                "type": "array",
                "additionalItems": false,
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      }
    }
  },
  "$defs":
  {
    "Attributes":
    {
      "type": "array",
      "additionalItems": false,
      "items": { "type": "integer"},
      "minItems": 1
    },
    "ScalarMaterialTable":
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["Freq", "Real"],
      "properties":
      {
        "Freq":
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "Real":
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "Imag":
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "LossTan":
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        }
      }
    }
  }
}
